NODE_ENV=development
PORT=4000

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=biashara_manager
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_SIZE=10
DB_SSL=false
BUSINESS_CURRENCIES=TZS,KES,UGX,USD
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
FRONTEND_URLS=http://localhost:3000

# Password reset delivery. Configure these before enabling password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
