NODE_ENV=development
PORT=4000

# PostgreSQL connection. Use the pooled connection string for serverless hosting.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/biashara_manager
DB_POOL_SIZE=10

# Optional legacy connection settings, used only when DATABASE_URL is not set.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=biashara_manager
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_SSL=false

# API behavior
BUSINESS_CURRENCIES=TZS,KES,UGX,USD
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
# Comma-separated exact browser origins; include every deployed frontend origin.
FRONTEND_URLS=http://localhost:3000
TRUST_PROXY=false

# Password reset delivery. Configure these before enabling password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=

# Cloudflare R2 product image storage. Keep credentials on the backend only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=biashara-manager-products
R2_PUBLIC_URL=
R2_ENDPOINT=

# Optional legacy aliases; prefer the canonical variables above.
# FRONTEND_URL=http://localhost:3000
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=YOUR_SMTP_PASSWORD
# MAIL_FROM_ADDRESS=
